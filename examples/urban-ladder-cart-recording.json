      ]
    },
    {
      "type": "click",
      "target": "main",
      "selectors": [
        ["aria/Add to Cart - Yura Solid Wood And Cane Bar Trolley (Danish Walnut Finish)"],
        ["[data-testid='pdp-add-to-cart-button']"],
        ["xpath///*[@data-testid=\"pdp-add-to-cart-button\"]"],
        ["pierce/[data-testid='pdp-add-to-cart-button']"],
        ["text/Add to Cart"]
      ],
      "offsetY": 29.6666259765625,
      "offsetX": 50.53125
    }
