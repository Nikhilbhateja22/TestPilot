          "type": "navigation",
          "url": "https://www.urbanladder.com/",
          "title": ""
        }
      ]
    },
    {
      "type": "click",
      "target": "main",
      "selectors": [
        ["aria/Search"],
        ["#inputSearch"],
        ["xpath///*[@id=\"inputSearch\"]"],
        ["pierce/#inputSearch"]
      ],
      "offsetY": 9,
      "offsetX": 214.5208282470703
    },
    {
      "type": "change",
      "value": "cart",
      "selectors": [
        ["[data-testid='search-input']"],
        ["xpath///*[@data-testid=\"search-input\"]"],
        ["pierce/[data-testid='search-input']"]
      ],
      "target": "main"
    },
    {
      "type": "keyDown",
      "target": "main",
      "key": "Enter"
    },
    {
      "type": "keyUp",
      "key": "Enter",
      "target": "main"
    },
    {
      "type": "click",
      "target": "main",
      "selectors": [
        ["aria/Yura Solid Wood And Cane Bar Trolley (Danish Walnut Finish)[role=\"image\"]"],
        ["html > body > #app > div > div.fdk-theme-outlet > div > div.MniCX > div.HOVM7 > div > [data-testid='plp-product-card'] > div.X0lDv > img"],
        ["xpath///*[@data-testid=\"plp-product-card\"]/div[1]/img"],
        ["pierce/html > body > #app > div > div.fdk-theme-outlet > div > div.MniCX > div.HOVM7 > div > [data-testid='plp-product-card'] > div.X0lDv > img"]
      ],
      "offsetY": 217,
      "offsetX": 112.33332824707031
    },
    {
      "type": "change",
      "value": "560001",
      "selectors": [
        ["[data-testid='pdp-pincode-input']"],
        ["xpath///*[@data-testid=\"pdp-pincode-input\"]"],
        ["pierce/[data-testid='pdp-pincode-input']"]
